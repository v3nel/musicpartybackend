{
  "name": "backend",
  "version": "0.0.1dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:dev && bun --watch src/index.ts",
    "db:migrate": "bunx prisma migrate deploy",
    "db:dev": "bun scripts/dbDev.ts",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && bun run db:dev",
    "start": "bun run db:migrate && bun src/index.ts",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/swagger-ui-express": "^4.1.8",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.1.3",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
