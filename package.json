{
  "name": "backend",
  "version": "0.0.1dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:dev && bun --watch src/index.ts",
    "db:migrate": "bunx prisma migrate deploy",
    "db:dev": "bun scripts/dbDev.ts",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && bun run db:dev",
    "start": "bun run db:migrate && bun src/index.ts",
    "lint": "bunx eslint .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
