{
  "name": "backend",
  "version": "0.0.1dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:dev && bun --watch src/index.ts",
    "db:migrate": "bunx prisma migrate deploy",
    "db:dev": "bun scripts/dbDev.ts",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && bun run db:dev",
    "start": "bun run db:migrate && bun src/index.ts",
    "lint": "bunx eslint ."
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "@types/bun": "^1.3.13",
    "prisma": "^7.8.0"
  }
}
